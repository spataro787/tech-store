rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    function validProduct(data) {
      return data.keys().hasAll([
          'name',
          'description',
          'price',
          'category',
          'stock',
          'imageUrl'
        ])
        && data.keys().hasOnly([
          'name',
          'description',
          'price',
          'category',
          'stock',
          'imageUrl'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 2000
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 60
        && data.price is number
        && data.price > 0
        && data.price <= 1000000000
        && data.stock is int
        && data.stock >= 0
        && data.stock <= 1000000
        && data.imageUrl is string
        && data.imageUrl.size() <= 2048;
    }

    function validCart(data) {
      return data.keys().hasAll(['items', 'updatedAt'])
        && data.keys().hasOnly(['items', 'updatedAt'])
        && data.items is list
        && data.items.size() <= 100
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid',
          'firstName',
          'lastName',
          'birthDate',
          'role'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'firstName',
          'lastName',
          'birthDate',
          'role'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.birthDate is string
        && request.resource.data.birthDate.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.role == 'customer';

      allow update, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /carts/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validCart(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
